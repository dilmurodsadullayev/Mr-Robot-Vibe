pids/
*.pid
*.seed
*.pid.lock


# Editor directories and files
.vscode/*
!.vscode/extensions.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Operating system files
.DS_Store
Thumbs.db


# Local files
*.local


# Cache
.cache/
.eslintcache


# Testing
coverage/


# Temporary files
tmp/
temp/
*.tmp