# Dependencies
node_modules/


# Production builds
dist/
dist-ssr/


# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local


# Logs
logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


